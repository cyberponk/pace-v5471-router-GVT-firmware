#!/bin/sh
# /etc/bewan/lib/dyndns-ni: dynamic DNS providers added by this firmware.
# Sourced from create_dyndns (lib/dyndns, dash, set -u: no exit, no unset variables) for
#   dynv6      DynDNS 2 at dynv6.com (dns.army, dynv6.net... names); user "none", password = token
#   nsupdate4  nsupdate.info IPv4; user = the hostname, password = the host's secret
#   nsupdate6  nsupdate.info IPv6; same account
#   customget  custom URL, plain HTTPS GET (cPanel dynamic DNS URL: the server takes the caller's IP)
# The generated update script ($dyndnscmd) is ash (a dash error would stop the watchdog). It reads
# the public address from a check-IP service (the WAN address may be behind another router),
# updates when it differs from the last successful update (Cache) or once a day, over HTTPS with
# certificate checks (static curl + Mozilla CA bundle), 10 s timeout. Runs at WAN up
# (ip-up.d/S60dyndns) and every 5 minutes (cron $cron_name, removed by stop_dyndns); "force" as
# first argument (scripts/ddns-now, the page's Update now button) updates even if unchanged.
# Each run first waits (up to 3 min) for the Internet and a set clock. Each run writes its steps to /var/status/ddns-<id>.log (no passwords; for the custom URL only
# its host), ending with a "result:" line; scripts/ddns-collect merges all accounts' logs into
# /var/status/ddns-all for the DDNS page.

DYNDNS_NI_LIB=1

# single-quoted for the generated script
dyndns_ni_q() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

create_dyndns_ni() {
  local family=4 check='' url='' auth='' ok='good|nochg' shown=''
  local user=$username
  case "$server" in
  dynv6)
    local srv=${servername:-dynv6.com}
    url="https://$srv/nic/update?hostname=$host&myip=@IP@"
    [ "$user" = '' ] && user=none
    auth="$user:$password"
    check='https://api.ipify.org https://ipv4.nsupdate.info/myip'
    ;;
  nsupdate4|nsupdate6)
    [ "$server" = nsupdate6 ] && family=6
    url="https://ipv$family.nsupdate.info/nic/update?hostname=$host&myip=@IP@"
    auth="$host:$password"
    check="https://ipv$family.nsupdate.info/myip"
    [ $family = 4 ] && check="$check https://api.ipify.org" || check="$check https://api6.ipify.org"
    ;;
  customget)
    local u; eval u=\${$cliroot'_URL':-}
    # Force SSL
    case "$u" in http://*) u="https://${u#http://}" ;; esac
    url=$u
    ok=''
    # the URL itself is the secret (cPanel webcall key): the log shows only its host
    shown=$(echo "$u" | sed 's#^\(https://[^/?]*\).*#\1/...#')
    check='https://api.ipify.org https://ipv4.nsupdate.info/myip'
    ;;
  esac

  [ "$shown" = '' ] && shown=$url
  cat >$dyndnscmd <<EOF
#!/bin/ash
# dynamic DNS update for $cliroot ($server), generated by /etc/bewan/lib/dyndns-ni
# \$1 = force: update even if the address is unchanged
LOCK=$lockfile.d
mkdir \$LOCK 2>/dev/null || exit 0
trap 'rmdir \$LOCK' EXIT
RUNLOG=/var/status/ddns-$DYNDNS_ID.log
mkdir -p /var/status
: > \$RUNLOG.tmp
step() { echo "\$*" >> \$RUNLOG.tmp; }
done_log() {
	step "last successful update: \$(cat $statusfile.when 2>/dev/null || echo never)"
	step "result: \$1"
	mv \$RUNLOG.tmp \$RUNLOG
	/etc/bewan/scripts/ddns-collect
}
step "time: \$(date '+%Y-%m-%d %H:%M:%S')"
step "provider: $server"
step "hostname: $host"
# at boot the WAN is up before the Internet check (tetherd, /var/status/tether) and before NTP has
# set the clock (HTTPS then sees the certificates as not yet valid): wait for both, up to 3 minutes
w=0; inet=''
while [ \$w -lt 180 ]; do
	inet=\$(sed -n 's/^internet=//p' /var/status/tether 2>/dev/null)
	[ "\$inet" = up ] && [ \$(date +%Y) -ge 2025 ] && break
	sleep 5; w=\$((w + 5))
done
[ \$w -gt 0 ] && step "waited: \$w s for the Internet and the clock"
if [ "\$inet" != up ] || [ \$(date +%Y) -lt 2025 ]; then
	step "Internet: \${inet:-unknown}, clock: \$(date '+%Y-%m-%d %H:%M')"
	done_log "postponed (no Internet or clock not set yet, retried in 5 minutes)"
	exit 0
fi
CURL="/usr/bin/curl -sS -m 10 -$family --cacert /etc/ssl/certs/ca-certificates.crt"
URL=$(dyndns_ni_q "$url")
AUTH=$(dyndns_ni_q "$auth")
OK=$(dyndns_ni_q "$ok")
log() { logger -t dyndns -p daemon.info "$cliroot: \$*"; }
status() { echo \$1 > $statusfile; }

ip=''
for c in $check; do
	ip=\$(\$CURL "\$c" 2>&1 | tr -d ' \r\n')
	case "\$ip" in *[!0-9a-fA-F.:]*|'') step "check IP: \$c -> failed (\$(echo "\$ip" | head -c 120))"; ip='' ;; *) step "check IP: \$c -> \$ip"; break ;; esac
done
if [ -z "\$ip" ]; then
	log "public address not found"
	status failed
	done_log "failed (public address not found)"
	exit 0
fi
prev=\$(printf 'cd _$cliroot\nget Cache\n' | cli -q 2>/dev/null)
stamp=$statusfile.time
now=\$(date +%s)
last=\$(cat \$stamp 2>/dev/null || echo 0)
step "last updated address: \${prev:-none}"
if [ "\${1:-}" != force ] && [ "\$ip" = "\$prev" ] && [ \$((now - last)) -lt 86400 ]; then
	status ok
	done_log "ok (address unchanged, no update needed)"
	exit 0
fi
step "request: \$(echo $(dyndns_ni_q "$shown") | sed "s/@IP@/\$ip/")"
u=\$(echo "\$URL" | sed "s/@IP@/\$ip/")
if [ -n "\$AUTH" ]; then
	r=\$(\$CURL -u "\$AUTH" "\$u" 2>&1)
else
	r=\$(\$CURL -w '%{http_code}' -o /dev/null "\$u" 2>&1)
fi
rc=\$?
if [ -n "\$OK" ]; then
	echo "\$r" | grep -qE "^(\$OK)" && good=1 || good=0
else
	[ \$rc = 0 ] && [ "\$r" = 200 ] && good=1 || good=0
fi
log "\$ip: \$(echo "\$r" | head -1)"
step "response: \$(echo "\$r" | head -3 | head -c 300)"
if [ \$good = 1 ]; then
	printf 'cd _$cliroot\nset Cache %s\nfcommit\n' "\$ip" | cli -s >/dev/null 2>&1
	echo \$now > \$stamp
	date '+%Y-%m-%d %H:%M:%S' > $statusfile.when
	status ok
	done_log ok
else
	status failed
	done_log failed
fi
EOF
  chmod 755 $dyndnscmd
  if [ ${CRON_LIB:-0} = 1 ]; then
    crontab_add '*/5' '*' '*' '*' '*' "$dyndnscmd" $cron_name
  fi
  # first update now
  start-stop-daemon -S -b -x $dyndnscmd -- 0
}
