diff --git a/kernel/linux/arch/mips/bcm963xx/Kconfig b/kernel/linux/arch/mips/bcm963xx/Kconfig
index 11b66c16..0d59de00 100755
--- a/kernel/linux/arch/mips/bcm963xx/Kconfig
+++ b/kernel/linux/arch/mips/bcm963xx/Kconfig
@@ -48,6 +48,16 @@ config BCM963268
 	select SYS_SUPPORTS_SMP
 	select NR_CPUS_DEFAULT_2
 	select BRCM_DCACHE_SHARED
+	# Not in the upstream GPL mirror (normally wired in by Broadcom's profile
+	# layer, absent from this checkout): the BCM63168/963268-family SoC has
+	# working EHCI/OHCI USB host controllers, confirmed independently from
+	# the real router's own shipped lib/modules/2.6.30/kernel/drivers/usb/
+	# host/{ehci,ohci}-hcd.ko. Needed so CONFIG_USB (and usbnet/rndis_host/
+	# cdc_ether under it) becomes selectable at all — USB_ARCH_HAS_OHCI/EHCI
+	# have no prompt of their own and default to n on non-PCI MIPS without
+	# this.
+	select USB_ARCH_HAS_OHCI
+	select USB_ARCH_HAS_EHCI
 
 endchoice
 
