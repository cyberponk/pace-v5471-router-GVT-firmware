diff --git a/kernel/linux/include/linux/compiler-gcc6.h b/kernel/linux/include/linux/compiler-gcc6.h
new file mode 100644
index 00000000..613a01be
--- /dev/null
+++ b/kernel/linux/include/linux/compiler-gcc6.h
@@ -0,0 +1,11 @@
+/*
+ * gcc 6 shim for this 2.6.30-era tree: include/linux/compiler-gcc.h dispatches on
+ * __GNUC__ to compiler-gcc{2,3,4}.h, with no entry past gcc4 (predates gcc5/6).
+ * gcc4's shim (branch-prediction/bitfield macros, all still valid on gcc6) is the
+ * closest supported one and is API-compatible for our purposes — just a missing
+ * file problem, not a real incompatibility.
+ *
+ * Not from upstream Linux; added locally for this cross-build. See
+ * tools/re/modules/BUILD_PLAN.md for why.
+ */
+#include <linux/compiler-gcc4.h>
diff --git a/kernel/linux/include/linux/netdevice.h b/kernel/linux/include/linux/netdevice.h
index 00264a0b..72f85dff 100644
--- a/kernel/linux/include/linux/netdevice.h
+++ b/kernel/linux/include/linux/netdevice.h
@@ -927,6 +927,13 @@ struct net_device
 	/* GARP */
 	struct garp_port	*garp_port;
 
+	/* cyberponk: the Pace V5471 kernel's net_device has 8 more bytes before `dev`
+	 * than this (ZyXEL/MitraStar) tree: router free_netdev() does put_device(dev + 0x258),
+	 * this header gives 0x250. Unknown vendor fields (NETPOLL is absent on the router);
+	 * padded so `dev` and everything after it (gso_max_size 0x31c, compat ops 0x344..,
+	 * sizeof 0x370) match the router. Verified by tools/re/probe/fingerprint.txt. */
+	void			*ni_pace_pad[2];
+
 	/* class/net/name entry */
 	struct device		dev;
 	/* space for optional statistics and wireless sysfs groups */
